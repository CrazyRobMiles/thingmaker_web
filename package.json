{
  "name": "thingmaker-web",
  "version": "1.0.0",
  "description": "Design 3D-printable enclosures for electronics in a web browser - a Node.js port of thingmaker",
  "type": "module",
  "main": "server.js",
  "bin": {
    "thingmaker": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "template": "node template.js",
    "test": "node --test test/",
    "parity": "node tools/parity.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "jpeg-js": "0.4.4",
    "manifold-3d": "3.5.4",
    "omggif": "1.0.10",
    "opentype.js": "1.3.4",
    "pngjs": "7.0.0",
    "three": "0.186.1"
  }
}
