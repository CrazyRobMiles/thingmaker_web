{
  "name": "thingmaker-web",
  "version": "1.0.0",
  "description": "Design 3D-printable enclosures for electronics in a web browser - a Node.js port of thingmaker",
  "type": "module",
  "main": "server.js",
  "bin": {
    "thingmaker": "server.js"
  },
  "imports": {
    "#files": {
      "browser": "./lib/files-browser.js",
      "default": "./lib/files-node.js"
    }
  },
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "template": "node template.js",
    "test": "node --test",
    "parity": "node tools/parity.mjs",
    "build:static": "node tools/build-static.mjs",
    "serve:static": "node tools/serve-static.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "manifold-3d": "3.5.4",
    "omggif": "1.0.10",
    "opentype.js": "1.3.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
